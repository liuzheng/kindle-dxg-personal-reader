#!/bin/sh
# Local diagnostic initramfs entry point. Requires a supplied static BusyBox.
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "DXG diagnostic initramfs"
echo "This image is local-only and is not approved for Kindle deployment."
exec /bin/sh
